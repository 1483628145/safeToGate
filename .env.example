# SafeTrade API credentials
SAFE_API_KEY=
SAFE_API_SECRET=

# Gate API v4 credentials
GATE_API_KEY=
GATE_API_SECRET=

# Optional overrides and live-trading safety lock
SAFE_MARKET=pearlusdt
GATE_MARKET=PEARL_USDT
SAFE_TAKER_FEE=0.001
GATE_TAKER_FEE=0.002
ENABLE_LIVE_TRADING=false

# Optional local SOCKS5 tunnel through the VPS
# First run: ssh -N -D 127.0.0.1:1080 user@163.53.18.71
HTTP_PROXY=socks5h://127.0.0.1:1080
HTTPS_PROXY=socks5h://127.0.0.1:1080
NO_PROXY=127.0.0.1,localhost

